rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // User profile is private to its owner. Do not store OAuth tokens or secrets here.
    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // Session metadata only. Never store screen frames, passwords, or raw input here.
    // Both participants must be authenticated; the creator is fixed at creation.
    match /sessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "ownerUid", "operatorUid", "status", "createdAt", "expiresAt"
        ]);
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.operatorUid == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.operatorUid == request.auth.uid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.operatorUid == resource.data.operatorUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt", "consentGrantedAt", "endedAt"]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Explicitly deny all unmodeled collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
