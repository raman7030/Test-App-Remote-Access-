rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // Metadata only. This is not a command/signaling channel.
    match /sessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.operatorUid == null
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "ownerUid", "operatorUid", "status", "createdAt", "expiresAt"
        ]);
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.operatorUid == request.auth.uid);
      allow update: if signedIn()
        && (
          // A signed-in operator may atomically claim one unclaimed, pending session.
          (resource.data.status == "pending"
            && resource.data.operatorUid == null
            && request.resource.data.operatorUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.status == "awaiting_consent"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["operatorUid", "status", "updatedAt"]))
          ||
          // Participants may update lifecycle metadata, but cannot change identities.
          ((resource.data.ownerUid == request.auth.uid
              || resource.data.operatorUid == request.auth.uid)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.operatorUid == resource.data.operatorUid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt", "consentGrantedAt", "endedAt"])
            && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
              || request.resource.data.status in ["consented", "denied", "ended"]))
        );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}